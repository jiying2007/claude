{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-runtime.local/schemas/runtime-execution-receipt.v2.schema.json",
  "title": "Claude Code Runtime Execution Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "runtime",
    "frozen_inputs_sha256",
    "verification_pass_claimed",
    "runtime_identity",
    "execution",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"const": "completed"},
    "runtime": {"const": "claude-code"},
    "frozen_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_pass_claimed": {"const": false},
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_binding_repository",
        "runtime_binding_commit",
        "runtime_target",
        "runtime_profile",
        "runtime_host",
        "runtime_provider",
        "runtime_version",
        "runtime_source_set_identity_ref",
        "runtime_distribution_identity_ref"
      ],
      "properties": {
        "runtime_binding_repository": {"const": "jiying2007/claude"},
        "runtime_binding_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runtime_target": {"const": "claude-code"},
        "runtime_profile": {"enum": ["minimal", "solo-dev", "team-collab"]},
        "runtime_host": {"type": "string", "minLength": 1},
        "runtime_provider": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "runtime_source_set_identity_ref": {"type": "string", "minLength": 1},
        "runtime_distribution_identity_ref": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "result_identity_ref"],
      "properties": {
        "started_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1},
        "result_identity_ref": {"type": "string", "minLength": 1},
        "source_identity_ref": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "summary": {"type": ["string", "null"]}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
